{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godia-prime-connect-music-site-ai-generator",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "GODIA_DB",
      "database_name": "godia-prime-connect-db",
      "database_id": "7bf06a70-56fa-4477-aa12-a52a7c8e0049"
    }
  ]
}
